# Copy to .env.local. Never commit real values.

# Required for Cek lokasi and Lapor (Anthropic API key, server side only)
ANTHROPIC_API_KEY=

# Optional AI limits (defaults shown); set AI_ENABLED=false to switch AI features off
AI_ENABLED=true
AI_DAILY_LIMIT=300
AI_PER_IP_LIMIT=20

# Optional: show LSD polygons on the map (off in the public build, see README)
NEXT_PUBLIC_TAMPILKAN_LSD=0
